#!/usr/bin/make -f
export PYBUILD_NAME = neo_arcade
export PYBUILD_DESTDIR = debian/neo-arcade
# Tests need pygame + a display; run via `make test`, not during package build.
export PYBUILD_DISABLE = test

%:
	dh $@ --with python3 --buildsystem=pybuild

execute_after_dh_install:
	install -Dm644 src/neo_arcade/assets/logo_de.png \
		debian/neo-arcade/usr/share/pixmaps/neo-arcade.png
